# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.xlsx
*.csv
.env*
/data/
.env*.local
/data/
!.env.example
!deploy/.env.example
deploy/docker-compose.subdomain.yml
deploy/.update.lock
# Import-Fixtures (nur erfundene Daten): ausschließlich CSV/XLSX wieder freigeben …
!src/lib/import/__fixtures__/**/*.csv
!src/lib/import/__fixtures__/**/*.xlsx
# … und Zugangsdaten darunter trotzdem ausschließen (nach den Freigaben, damit z. B. .env.csv ignoriert bleibt)
src/lib/import/__fixtures__/**/.env*
src/lib/import/__fixtures__/**/*.pem
src/lib/import/__fixtures__/**/*.key
src/lib/import/__fixtures__/**/*[Zz]ugang*
src/lib/import/__fixtures__/**/[Cc]redentials*
src/lib/import/__fixtures__/**/*.state.json
