# ── Datenbank ─────────────────────────────────────────────
# App-Rolle OHNE Superuser-Rechte (unterliegt Row-Level-Security)
DATABASE_URL=postgres://podo_app:CHANGE_ME@localhost:5432/podo
# Eigentümer-Rolle nur für Migrationen
DATABASE_MIGRATION_URL=postgres://podo_owner:CHANGE_ME@localhost:5432/podo
DB_APP_ROLE=podo_app

# ── Sicherheit ────────────────────────────────────────────
# 32 Byte, base64:  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Weitere Praxen dürfen sich registrieren (SaaS-Modus)
ALLOW_SIGNUP=false
PUBLIC_URL=https://crm.example.de

# ── Dateien (Fotos/Audio, verschlüsselt) ─────────────────
STORAGE_DIR=./data/storage

# ── Schnittstellen ────────────────────────────────────────
# mock = alle Adapter im Testmodus (keine echten Aufrufe)
INTEGRATIONS_MODE=mock
# KI (OpenAI-kompatibel). NUR EU-Anbieter mit AVV + Zero Data Retention für echte Patientendaten!
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Erst auf true setzen, wenn AVV + Zero-Data-Retention mit dem Anbieter vorliegt
LLM_DATA_PROCESSING_APPROVED=false
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_DATA_PROCESSING_APPROVED=false
# Einmal-Code für die Ersteinrichtung (/einrichtung). Pflicht auf öffentlich erreichbaren Servern!
SETUP_TOKEN=

# ── Erinnerungen / Cron ───────────────────────────────────
# Schützt POST /api/cron/reminders (Authorization: Bearer <CRON_SECRET>). Leer = Erinnerungsdienst aus (503).
# Erzeugen: openssl rand -base64 32
CRON_SECRET=

# ── Kasse/TSE (KassenSichV) ───────────────────────────────
# Ohne Vertrag mit einer zertifizierten TSE nur Test-Signaturen (mock). Echt: TSE_PROVIDER=fiskaly + Zugangsdaten.
TSE_PROVIDER=mock
FISKALY_API_KEY=
FISKALY_API_SECRET=
FISKALY_TSS_ID=
FISKALY_CLIENT_ID=
