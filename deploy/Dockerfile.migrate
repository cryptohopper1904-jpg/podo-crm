FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
RUN pnpm install --frozen-lockfile
COPY drizzle ./drizzle
COPY scripts ./scripts
COPY src/db ./src/db
COPY src/lib/org-defaults.ts src/lib/records.ts ./src/lib/
# Migrationen als Eigentümer; optional Demo-Praxis (erfundene Daten) als App-Rolle
CMD ["sh", "-c", "pnpm exec tsx scripts/migrate.ts && if [ \"$SEED_DEMO\" = \"true\" ]; then DATABASE_URL=\"$DATABASE_SEED_URL\" pnpm exec tsx scripts/seed-demo.ts; fi"]
