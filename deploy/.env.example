DOMAIN=crm.deine-praxis.de
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
BACKUP_PASSPHRASE=
# --- App ---
APP_ENCRYPTION_KEY=
PUBLIC_URL=https://crm.deine-praxis.de
ALLOW_SIGNUP=false
INTEGRATIONS_MODE=mock
LLM_DATA_PROCESSING_APPROVED=false
TRANSCRIPTION_DATA_PROCESSING_APPROVED=false
SETUP_TOKEN=
# Demo-Praxis (nur Test): SEED_DEMO=true. Auf einer echten Domain ohne SEED_DEMO_PASSWORD wird ein Zufallspasswort
# erzeugt und einmal im migrate-Log ausgegeben (docs/BETRIEB.md, Abschnitt 1)
# SEED_DEMO=false
# SEED_DEMO_PASSWORD=
# Anzahl vertrauenswürdiger Proxys vor der App (X-Forwarded-For von rechts), Standard 1 = Caddy. Siehe docs/BETRIEB.md
TRUSTED_PROXY_HOPS=1

# ── Erinnerungen / Cron ───────────────────────────────────
# Schützt POST /api/cron/reminders (Authorization: Bearer <CRON_SECRET>). Leer = Erinnerungsdienst aus (503).
# Erzeugen: openssl rand -base64 32
CRON_SECRET=

# ── Kasse/TSE (KassenSichV) ───────────────────────────────
# Ohne Vertrag mit einer zertifizierten TSE nur Test-Signaturen (mock). Echt: TSE_PROVIDER=fiskaly + Zugangsdaten.
TSE_PROVIDER=mock
FISKALY_API_KEY=
FISKALY_API_SECRET=
FISKALY_TSS_ID=
FISKALY_CLIENT_ID=

# E-Mail-Versand (Plattform-Standard, falls eine Praxis keinen eigenen SMTP-Zugang hinterlegt)
# SMTP_URL=smtps://benutzer:passwort@smtp.example.de:465
# SMTP_FROM=noreply@example.de
# MAIL_RATE_PER_HOUR=300

# ── Touren / Fahrtenbuch (Hausbesuche) ────────────────────
# Routing nur mit Koordinaten (nie Namen). Produktion: eigener OSRM-Server ODER openrouteservice-Schlüssel,
# sonst Schätzung Luftlinie × 1,3. Der öffentliche OSRM-Demo-Server wird nur in der Entwicklung genutzt.
# ROUTING_PROVIDER=osrm   # osrm | ors | off
# OSRM_URL=https://osrm.example.de
# ORS_API_KEY=
# ORS_URL=https://api.openrouteservice.org
# Geokodierung der Adressen (Photon/OpenStreetMap), Standard https://photon.komoot.io
# PHOTON_URL=

# ── Betrieb / Monitoring (docs/BETRIEB.md → Monitoring) ───
# Token für GET /api/health/deep (Authorization: Bearer …), mind. 16 Zeichen. Leer = Endpunkt antwortet 503.
# Eigener Wert empfohlen, wenn ein externer Monitoring-Dienst abfragt: openssl rand -base64 32
HEALTH_TOKEN=
# Aufbewahrung lokaler Backups in Tagen (Offsite-Kopie: deploy/offsite-backup.example.sh)
BACKUP_RETENTION_DAYS=14
# Optionales Fehler-Reporting (nur Route-Muster, Fehlername, gekürzte Meldung – keine Patientendaten).
# Nur mit AVV und EU-Region (z. B. Sentry EU: https://<key>@o….ingest.de.sentry.io/<projekt>)
# SENTRY_DSN=
# Alternativ/zusätzlich ein eigener HTTPS-Webhook (JSON per POST), optional mit Bearer-Token
# ERROR_WEBHOOK_URL=https://monitoring.example.de/hooks/podocrm
# ERROR_WEBHOOK_TOKEN=

# ── Adress-Vorschläge (docs/BETRIEB.md → Adress-Vorschläge) ───
# photon (Standard) = öffentliche Photon-Instanz von Komoot (OSM); off = abgeschaltet.
# Es wird nur der eingetippte Adresstext übertragen, keine Namen/Gesundheitsdaten.
# ADDRESS_PROVIDER=photon
# Eigene Photon-Instanz (Datenschutz-Maximum), nur https mit öffentlich auflösbarer Adresse:
# PHOTON_URL=https://photon.example.de

# ── Bootstrap ohne Shell (scripts/bootstrap.ts im migrate-Container, idempotent) ──
# Plattform-Admin (ohne Praxis; 2FA beim ersten Login unter /login/2fa-einrichten). Bestehende Konten werden nie geändert.
#BOOTSTRAP_ADMIN_EMAIL=
#BOOTSTRAP_ADMIN_NAME=
#BOOTSTRAP_ADMIN_PASSWORD=
# Demo-Praxis „Demo-Praxis (Beispieldaten)“ mit erfundenen Daten; der Admin wird Inhaber:in (Standard: an)
#BOOTSTRAP_ADMIN_DEMO=false
# Optionale Praxis: Pfad im Repository oder JSON-Text, z. B. deploy/bootstrap/kiehne.json (nur Geschäftsangaben)
#BOOTSTRAP_PRACTICE_JSON=
# Passwort der Inhaber:in – NUR hier, nie in der JSON-Datei
#BOOTSTRAP_PRACTICE_OWNER_PASSWORD=
# true = Konfigurationsfehler lassen den migrate-Container (und damit den App-Start) fehlschlagen
#BOOTSTRAP_STRICT=false
